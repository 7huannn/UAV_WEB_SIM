{
  "name": "uav-arena",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --import tsx --test --test-isolation=none src/tests/*.test.ts",
    "test:camera-browser": "node scripts/camera-flight-browser-check.mjs",
    "test:browser": "node scripts/redesign-browser-check.mjs",
    "test:training-browser": "node scripts/redesign-browser-check.mjs",
    "test:ux-browser": "node scripts/redesign-browser-check.mjs",
    "test:task-ux-browser": "node scripts/redesign-browser-check.mjs",
    "test:native-zoom-browser": "node scripts/native-zoom-browser-check.mjs",
    "test:redesign-browser": "node scripts/redesign-browser-check.mjs",
    "test:conditions-browser": "node scripts/conditions-browser-check.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.183.0",
    "@vitejs/plugin-react": "latest",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "8.3.8"
  }
}
